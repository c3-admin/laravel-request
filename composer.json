{
    "name": "yahlox/rbac",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Yahlox\\Rbac\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
        "Yahlox\\Rbac\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Yahlox\\Rbac\\Providers\\RBACServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
